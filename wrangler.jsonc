{
  // getbuildup.app en Cloudflare Workers.
  //
  //  - dist/            el sitio estatico (lo genera build.py)
  //  - worker/index.js  recibe el webhook de RevenueCat en /api/rc-webhook
  //                     y manda el correo de bienvenida con Resend.
  //
  // Los secretos (RESEND_API_KEY, RC_WEBHOOK_SECRET, FIREBASE_SA) se guardan
  // en Cloudflare, nunca en este repositorio.
  "name": "getbuildup-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  // UID de la cuenta de prueba (team@mariagabsfitness.com). Solo se usa
  // cuando se pulsa "Send Test Event" en RevenueCat, para comprobar que el
  // correo de bienvenida sale bien. No es un dato secreto.
  "vars": {
    "TEST_UID": "scBKEdN5ngQz60QlxWWCrBciTyP2",
    "TEST_PLANTILLA": "bienvenida"
  },
  // Donde apuntamos los correos de vuelta que quedan programados, para poder
  // cancelarlos si la persona se suscribe antes de que salgan.
  "kv_namespaces": [
    { "binding": "PENDIENTES", "id": "d7badad70a0c4de792ed39307556e54b" }
  ],
  // El reloj que manda los correos de vuelta. Las dos horas cubren el cambio
  // de horario: el Worker comprueba cual de las dos es la tarde en Miami.
  "triggers": { "crons": ["0 20 * * *", "0 21 * * *"] },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
